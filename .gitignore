# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare — local dev state (live SQLite files; also keeps Tailwind's
# project scan out of them, which panics Turbopack on Windows) + build output
/.wrangler/
/.open-next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated files
/manifest.json
/public/apps/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
