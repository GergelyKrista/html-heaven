# NextAuth (GitHub OAuth)
AUTH_GITHUB_ID=              # GitHub OAuth App Client ID
AUTH_GITHUB_SECRET=          # GitHub OAuth App Client Secret
AUTH_SECRET=                 # Random string: openssl rand -base64 32
AUTH_URL=https://htmlheaven.com

# GitHub (for PR submissions)
GITHUB_PAT=                  # Fine-grained PAT with Contents + Pull requests (read/write)
GITHUB_OWNER=GergelyKrista
GITHUB_REPO=html-heaven

# Cloudflare (set as GitHub repo secrets, not Worker secrets)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
